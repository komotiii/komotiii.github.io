---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kazuki Komaba | Home" description="Kazuki Komaba home page with projects, lifestyle logs, gear setup, and current status.">

    <main id="top">
        <section class="hero reveal">
            <p class="kicker">Home</p>
            <h1>Kazuki Komaba</h1>
            <p class="hero-lead">
                I write code and ride roads.
                This is where I collect both my engineering work and daily logs.
            </p>
            <p class="hero-lead">
                I want to be an engineer who doesn't just know the cutting edge, but has used it and can talk about it.
            </p>
            <p class="hero-role">Physics Graduate Student / Builder</p>
            <div class="cta-row">
                <a class="btn btn-primary" href="https://github.com/komotiii" target="_blank" rel="noopener noreferrer">View GitHub</a>
                <a class="btn btn-ghost" href="/projects">View Projects</a>
                <a class="btn btn-ghost" href="/now">View Current Status</a>
            </div>
        </section>

        <section class="content-section reveal">
            <div class="section-head">
                <p class="kicker">Snapshot</p>
                <h2>Overview</h2>
            </div>
            <div class="stats-grid">
                <article class="metric">
                    <span class="metric-label">Primary Mode</span>
                    <span class="metric-value">Build + Ops</span>
                </article>
                <article class="metric">
                    <span class="metric-label">Current Base</span>
                    <span class="metric-value">Tsukuba</span>
                </article>
                <article class="metric">
                    <span class="metric-label">Coverage</span>
                    <span class="metric-value">Tech + Life</span>
                </article>
            </div>
        </section>

        <section class="content-section reveal">
            <div class="section-head">
                <p class="kicker">Highlight</p>
                <h2>Featured Projects</h2>
            </div>
            <div class="card-grid card-grid-two">
                <article class="project-card">
                    <h3>Real-time Monitoring Web App</h3>
                    <p class="summary">Client work, built solo from requirements to delivery. The code is private.</p>
                    <ul class="tech-tags"><li>Python</li><li>FastAPI</li><li>React</li></ul>
                </article>
                <article class="project-card">
                    <h3>Python Automation Scripts</h3>
                    <p class="summary">Repository-scale automation pack covering calendar tasks, weather API integration, desktop monitoring, and notification bots.</p>
                    <ul class="tech-tags"><li>Python</li><li>Google APIs</li><li>Automation</li></ul>
                    <a class="card-link" href="https://github.com/komotiii/python-automation-scripts" target="_blank" rel="noopener noreferrer">View on GitHub</a>
                </article>
            </div>

            <div class="section-actions section-actions-right">
                <a class="btn btn-ghost" href="/projects">View All Projects <span>→</span></a>
            </div>
        </section>

        <section class="content-section reveal">
            <div class="section-head">
                <p class="kicker">Identity</p>
                <h2>Lifestyle & Gear</h2>
            </div>
            <div class="card-grid card-grid-two">
                <article class="project-card">
                    <h3>Motorcycle & Hobbies</h3>
                    <p class="summary">Riding my GSX250R across Ibaraki, playing instruments (Guitar/Keyboard), and exploring new ramen shops.</p>
                    <ul class="tech-tags"><li>MotorCycle</li><li>Music</li><li>Gaming</li><li>Ramen</li></ul>
                </article>
                <article class="project-card">
                    <h3>Workspace Setup</h3>
                    <p class="summary">A self-built desktop that stays on at home and a MacBook Air for going out, set up with custom AHK scripts.</p>
                    <ul class="tech-tags"><li>Env</li><li>PC</li></ul>
                </article>
            </div>
            <div class="section-actions section-actions-wrap section-actions-right">
                <a class="btn btn-ghost" href="/lifestyle">View Lifestyle <span>→</span></a>
                <a class="btn btn-ghost" href="/gear">View Gear <span>→</span></a>
            </div>
        </section>

    </main>
</BaseLayout>
